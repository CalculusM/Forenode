# ------------------------------------------------------------------
# Forenode 운영 환경변수 예시 (저장소 추적 파일, 실제 키 값 기입 금지)
#
# Docker 경로:  cp .env.example .env && chmod 600 .env   (deploy/ 폴더에서)
# systemd 경로: sudo install -m 600 -o root -g root .env.example /etc/forenode/forenode.env
# 이후 서버에서만 값 기입. 값에 따옴표·공백 금지(KEY=VALUE 한 줄 형식)
# ------------------------------------------------------------------

# 법제 RAG 탭(OpenAI 임베딩 text-embedding-3-small, 응답 gpt-4o-mini) 전용
# 비워 두면 RAG 탭만 "OPENAI_API_KEY가 설정되지 않았습니다" 안내 표시, 나머지 기능 정상(로컬 AppTest 확인)
# 기입 시 RAG 질의 텍스트가 OpenAI API(미국)로 전송됨 = 보안 1페이저 "국내 체류" 적용 범위에서 명시 필요
OPENAI_API_KEY=

# 한국은행 ECOS 기준금리 조회(선택)
# 현재 앱은 사이드바 입력값을 우선 사용하며 버튼도 입력값 기준으로 활성화됨 = 비워 두어도 무방
ECOS_API_KEY=
